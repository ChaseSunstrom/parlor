# Copy to .env and edit. Everything here is optional except the two folders.

# where your music is (music-fndr's folder) and where downloaded videos go
MUSIC_DIR=/data/music
VIDEO_DIR=/data/videos
TZ=Etc/UTC

# yeerr's port (it uses the host's network)
PORT=8800

# Seerr: the address yeerr uses, and its API key (or paste the key in Settings)
SEERR_URL=http://localhost:5055
# SEERR_API_KEY=

# Jellyfin: sign in with Jellyfin accounts, and music-fndr makes its playlists in Jellyfin
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=
# JELLYFIN_USER=

# music-fndr: see its README for these
# FORMAT=mp3
# BITRATE=128k
# OUTPUT={album-artist}/{album}/{track-number} - {title}.{output-ext}
# THREADS=4
# SYNC_HOURS=24

# videos downloading at once, and how often yt-dlp is updated (hours; 0 = only at start)
# YT_PARALLEL=2
# UPDATE_HOURS=24
# anyone who can reach yeerr may create an account (also a switch in Settings)
# OPEN_SIGNUP=0

# Copy to .env and edit. That's all the setup there is: Parlor configures the apps itself.

# your media folder: shows, movies, music, youtube, books and downloads go in it
DATA=/srv/media
# a kind of media that lives outside DATA (another disk, a library you already have); unset, it's the
# folder of that name in DATA. The apps still see /data/<kind>. Moving into or out of a kind set here is a
# copy, not instant (see the README), so set only the ones outside DATA.
# MOVIES=/mnt/disk2/films
# SHOWS=/mnt/disk2/shows
# MUSIC=/mnt/disk2/music
# BOOKS=/mnt/disk2/books
# GAMES=/mnt/disk2/games
# YOUTUBE=/mnt/disk2/youtube
# DOWNLOADS=/mnt/disk2/downloads
# the user and group that own it (run `id` to see yours), and your time zone
PUID=1000
PGID=1000
TZ=Etc/UTC

# your home network, so you can still reach qBittorrent's page through the VPN
# (the VPN itself: upload your provider's WireGuard file in Parlor, Settings → Services → VPN)
LAN_SUBNET=192.168.0.0/16

# Parlor's port
# PORT=8800

# behind a reverse proxy (Caddy, nginx, Traefik): its address as Parlor sees it, comma-separated for more than one,
# so the limits on guessing passwords and TV codes count each person, not the proxy. "*" only if nothing else can reach Parlor
# FORWARDED_ALLOW_IPS=172.18.0.5

# Games → Play from your PC (optional): stream games from a PC running Sunshine to any browser or TV.
# Turn on both lines, set this server's address on your network, and open UDP 40000-40100 to it (README → Games)
# COMPOSE_PROFILES=games-stream
# GAMES_STREAM=1
# GAMES_STREAM_HOST=192.168.1.20

# public indexers Prowlarr gets (Prowlarr's own names); "none" adds none
# PUBLIC_INDEXERS=yts,eztv,thepiratebay,1337x,limetorrents,nyaasi,knaben

# music-fndr: see its README for these
# FORMAT=mp3
# BITRATE=128k
# OUTPUT={album-artist}/{album}/{track-number} - {title}.{output-ext}
# SYNC_HOURS=24

# videos downloading at once; how often yt-dlp is updated (hours; 0 = never); delete downloaded videos after N days (0 = keep)
# YT_PARALLEL=2
# UPDATE_HOURS=24
# when YouTube changes something and downloads fail, yt-dlp is updated at once (0 = only on the schedule above)
# HEAL=1
# Parlor's data is encrypted at rest with the key in ./parlor/key (back it up: Settings → Security); 0 keeps a new install plain
# ENCRYPT=1
# VIDEO_KEEP_DAYS=0
# anyone who can reach Parlor may create an account (also a switch in Settings)
# OPEN_SIGNUP=0
# the app's own copy on phones and computers (for opening offline); off makes every device's copy remove itself
# OFFLINE=on

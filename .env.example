# Copy to .env and edit. That's all the setup there is: Parlor configures the apps itself.

# your media folder: shows, movies, music, youtube, books and downloads go in it
DATA=/srv/media
# each kind of media can live somewhere else (another disk, a library you already have); the default is DATA/<kind>.
# The apps still see /data/<kind>. Moves between different disks are copies, not instant (see the README).
# MOVIES=/srv/films
# SHOWS=/srv/media/shows
# MUSIC=/srv/media/music
# BOOKS=/srv/media/books
# GAMES=/srv/media/games
# YOUTUBE=/srv/media/youtube
# DOWNLOADS=/srv/media/downloads
# the user and group that own it (run `id` to see yours), and your time zone
PUID=1000
PGID=1000
TZ=Etc/UTC

# your home network, so you can still reach qBittorrent's page through the VPN
# (the VPN itself: upload your provider's WireGuard file in Parlor, Settings → Services → VPN)
LAN_SUBNET=192.168.0.0/16

# Parlor's port
# PORT=8800

# public indexers Prowlarr gets (Prowlarr's own names); "none" adds none
# PUBLIC_INDEXERS=yts,eztv,thepiratebay,1337x,limetorrents,nyaasi,knaben

# music-fndr: see its README for these
# FORMAT=mp3
# BITRATE=128k
# OUTPUT={album-artist}/{album}/{track-number} - {title}.{output-ext}
# SYNC_HOURS=24

# videos downloading at once; how often yt-dlp is updated (hours; 0 = never); delete downloaded videos after N days (0 = keep)
# YT_PARALLEL=2
# UPDATE_HOURS=24
# when YouTube changes something and downloads fail, yt-dlp is updated at once (0 = only on the schedule above)
# HEAL=1
# VIDEO_KEEP_DAYS=0
# anyone who can reach Parlor may create an account (also a switch in Settings)
# OPEN_SIGNUP=0
